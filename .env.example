# Copy to .env.local for local development and fill in the values.
# In production, set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# ── Supabase (users, OTP codes, refresh tokens) ──────────────────────────────
# Supabase → Project Settings → API
SUPABASE_URL=
# Server-only key that bypasses Row Level Security. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── JWT signing ──────────────────────────────────────────────────────────────
# Two different random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Upstash Redis (waitlist, rate limiting, admin sessions) ──────────────────
# Upstash console → your database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Admin dashboard (/admin) ─────────────────────────────────────────────────
ADMIN_PASSWORD=

# ── Email via Resend (OTP codes) ─────────────────────────────────────────────
# Anything other than "true" skips sending, so sign-up works without email.
EMAIL_ENABLED=false
RESEND_API_KEY=
# Must be on a domain verified in Resend. Defaults to noreply@rendoz.com.
EMAIL_FROM=
